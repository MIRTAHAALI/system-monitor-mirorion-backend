[TEMPLATE]
NODE_ENV=development
PORT=4000

CORS_ORIGIN=https://mirorion.com

METRICS_INTERVAL_MS=1000
PROCESS_INTERVAL_MS=3000
NETWORK_INTERVAL_MS=1000
DISK_INTERVAL_MS=2000
TEMPERATURE_INTERVAL_MS=3000

METRICS_HISTORY_SIZE=300
HISTORY_RETENTION_POLICY=1d
HISTORY_CACHE_ENTRIES=5000

ENABLE_GPU_MONITORING=true
ENABLE_BATTERY_MONITORING=true
ENABLE_PROCESS_MONITORING=true

AUTH_ENABLED=false

# Session token lifetime in seconds (default 7 days)
JWT_EXPIRES_IN_SECONDS=604800
# Swagger UI at /api/docs; defaults to off when NODE_ENV=production
# ENABLE_SWAGGER=true

# Admin login. When set, these override data/.credentials.json and skip the startup prompt.
# Prefer ADMIN_PASSWORD_HASH: generate it with `npm run hash-password`.
# Use only one of ADMIN_PASSWORD_HASH / ADMIN_PASSWORD.
# ADMIN_USERNAME=admin
# ADMIN_PASSWORD_HASH=
# ADMIN_PASSWORD=
# Token signing key (at least 32 chars). Defaults to data/.jwt_secret, created on first start.
# Generate one with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# JWT_SECRET=
